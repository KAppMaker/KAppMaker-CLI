{
  "name": "kappmaker",
  "version": "2.1.0",
  "description": "The CLI behind KAppMaker AI, the agentic Kotlin Multiplatform app development kit you install on your own laptop or server: create, configure, build and ship Android and iOS apps from one command line.",
  "homepage": "https://kappmaker.com",
  "license": "MIT",
  "author": "KAppMaker (https://kappmaker.com)",
  "bugs": {
    "url": "https://github.com/KAppMaker/KAppMaker-CLI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KAppMaker/KAppMaker-CLI.git"
  },
  "keywords": [
    "kotlin-multiplatform",
    "compose-multiplatform",
    "kmp",
    "android",
    "ios",
    "mobile-app-development",
    "agentic",
    "ai-agent",
    "claude-code",
    "app-army",
    "self-hosted",
    "fastlane",
    "app-store-connect",
    "google-play",
    "cli"
  ],
  "type": "module",
  "bin": {
    "kappmaker": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsc && cp src/templates/Fastfile.txt src/templates/ios-ci-workflow.yml src/templates/ios-ci-lane.rb dist/templates/",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test:ppp": "tsx src/services/ppp-pricing.service.test.ts",
    "test:ios-ci": "tsx src/commands/ios-ci.test.ts",
    "lint": "tsc --noEmit",
    "test": "npm run test:ppp && npm run test:ios-ci && npm run test:army && npm run test:prereqs && npm run test:headless && npm run test:mcp && npm run test:publish-guard",
    "test:army": "tsx --test src/commands/army.test.ts",
    "test:prereqs": "tsx --test src/utils/prereqs.test.ts",
    "test:headless": "tsx --test src/utils/headless.test.ts",
    "test:mcp": "tsx --test src/mcp/mcp.test.ts src/mcp/army.test.ts",
    "test:mcp-e2e": "tsx --test src/mcp/army.e2e.test.ts",
    "prepublishOnly": "npm run build && node scripts/prepublish-check.mjs",
    "test:publish-guard": "node scripts/prepublish-check.mjs --self-test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "execa": "^10.2.1",
    "fs-extra": "^11.4.1",
    "ora": "^10.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
